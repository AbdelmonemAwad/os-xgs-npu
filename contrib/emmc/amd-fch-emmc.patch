+/*
+ * The AMD FCH controller's capability and quirk, as Linux sets them
+ * (sdhci-pci-core.c, amd_probe()).  The CMD19 bus test is never sent: on
+ * this controller its write never completes, and the eMMC then answers no
+ * command until its power is removed.  And on the chipsets before the one
+ * whose SMBus (0x790b) is revision 0x51 or later - the Hudson-2 and the "CZ"
+ * generation - Transfer Mode is cleared before a command without data.
+ *
+ * Its full reset is sdhci_pci_reset()'s, below.
+ */
+static uint32_t
+sdhci_pci_amd_fch(device_t dev, u_int *quirks)
+{
+	device_t smbus;
+
+	smbus = pci_find_device(AMD_VENDOR, AMD_HUDSON2_SMBUS);
+	if (smbus == NULL) {
+		smbus = pci_find_device(AMD_VENDOR, AMD_KERNCZ_SMBUS);
+		if (smbus != NULL &&
+		    pci_get_revid(smbus) >= AMD_KERNCZ_SMBUS_REV_NL)
+			smbus = NULL;
+	}
+	if (smbus != NULL)
+		*quirks |= SDHCI_QUIRK_CLEAR_TRANSFER_MODE;
+	if (bootverbose)
+		device_printf(dev, "no bus test%s\n", smbus != NULL ?
+		    ", Transfer Mode cleared before commands" : "");
+	return (MMC_CAP_NO_BUS_TEST);
+}
+
+/*
+ * A full reset of the AMD FCH controller goes through the PCI power states
+ * first, as Linux's amd_sdhci_reset() does: 0x7906 needs a hard reset to
+ * clear all of its internal state, and its own software reset does not
+ * bring it back from a stuck command.  The power state is written to the
+ * power management register directly rather than with pci_set_powerstate():
+ * this method runs with the slot's mutex held, and pci_set_powerstate() can
+ * go through ACPI, which sleeps.  D3hot to D0 may reset the configuration
+ * space, so it is saved before and restored after; the device is in D0
+ * again by then, so pci_restore_state() does not change its power state.
+ * The card detect logic is reset with the rest, and is given up to 100 ms
+ * to settle before the generic reset.  Other controllers, and the partial
+ * resets, go to the generic reset alone, as without this method.
+ */
+static void
+sdhci_pci_reset(device_t dev, struct sdhci_slot *slot, uint8_t mask)
+{
+	uint16_t status;
+	int i, pmc;
+
+	if (pci_get_devid(dev) == AMD_FCH_SD &&
+	    (mask & SDHCI_RESET_ALL) != 0 &&
+	    pci_find_cap(dev, PCIY_PMG, &pmc) == 0) {
+		pci_save_state(dev);
+		pci_disable_busmaster(dev);
+		status = pci_read_config(dev, pmc + PCIR_POWER_STATUS, 2) &
+		    ~PCIM_PSTAT_DMASK;
+		pci_write_config(dev, pmc + PCIR_POWER_STATUS,
+		    status | PCIM_PSTAT_D3, 2);
+		DELAY(10000);
+		pci_write_config(dev, pmc + PCIR_POWER_STATUS,
+		    status | PCIM_PSTAT_D0, 2);
+		DELAY(10000);
+		pci_restore_state(dev);
+		for (i = 0; i < 10; i++) {
+			if (sdhci_pci_read_4(dev, slot, SDHCI_PRESENT_STATE) &
+			    SDHCI_CARD_STABLE)
+				break;
+			DELAY(10000);
+		}
+	}
+	sdhci_generic_reset(dev, slot, mask);
+}
