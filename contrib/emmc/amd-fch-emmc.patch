+/*
+ * Find the widest bus width without the bus test above, for a host that
+ * cannot take it (MMC_CAP_NO_BUS_TEST): on some controllers the CMD19 write
+ * never completes and the card answers no command after it until its power
+ * is removed.  This is how Linux finds the width on every host: the card is
+ * switched to a width with CMD6, EXT_CSD is read again over that width, and
+ * the width is kept only when the fields that cannot change read back as
+ * they did over the 1-bit bus.  Like mmc_test_bus_width(), it leaves the card
+ * and the host at 1 bit; mmc_calculate_clock() switches both to the width
+ * found here.
+ */
+static int
+mmc_compare_bus_width(struct mmc_softc *sc, struct mmc_ivars *ivar)
+{
+	static const struct {
+		enum mmc_bus_width	width;
+		uint32_t		cap;
+		uint8_t			value;
+	} widths[] = {
+		{ bus_width_8, MMC_CAP_8_BIT_DATA, EXT_CSD_BUS_WIDTH_8 },
+		{ bus_width_4, MMC_CAP_4_BIT_DATA, EXT_CSD_BUS_WIDTH_4 }
+	};
+	/* The read-only fields Linux compares, mmc_compare_ext_csds(). */
+	static const uint8_t fields[] = {
+		EXT_CSD_PART_SUPPORT, EXT_CSD_ERASED_MEM_CONT, EXT_CSD_REV,
+		EXT_CSD_STRUCTURE, EXT_CSD_CARD_TYPE, EXT_CSD_S_A_TIMEOUT,
+		EXT_CSD_HC_WP_GRP_SIZE, EXT_CSD_ERASE_TO_MULT,
+		EXT_CSD_ERASE_GRP_SIZE, EXT_CSD_SEC_TRIM_MULT,
+		EXT_CSD_SEC_ERASE_MULT, EXT_CSD_SEC_FEATURE_SUPPORT,
+		EXT_CSD_TRIM_MULT, EXT_CSD_SEC_CNT, EXT_CSD_SEC_CNT + 1,
+		EXT_CSD_SEC_CNT + 2, EXT_CSD_SEC_CNT + 3
+	};
+	uint8_t *ext_csd;
+	u_int i, j;
+	int err, width;
+
+	width = bus_width_1;
+	ext_csd = malloc(MMC_EXTCSD_SIZE, M_DEVBUF, M_WAITOK);
+	for (i = 0; i < nitems(widths) && width == bus_width_1; i++) {
+		if ((mmcbr_get_caps(sc->dev) & widths[i].cap) == 0)
+			continue;
+		sc->squelched++; /* Errors are expected, squelch reporting. */
+		err = mmc_switch(sc->dev, sc->dev, ivar->rca,
+		    EXT_CSD_CMD_SET_NORMAL, EXT_CSD_BUS_WIDTH, widths[i].value,
+		    ivar->cmd6_time, true);
+		if (err == MMC_ERR_NONE) {
+			mmcbr_set_bus_width(sc->dev, widths[i].width);
+			mmcbr_update_ios(sc->dev);
+			err = mmc_send_ext_csd(sc->dev, sc->dev, ext_csd);
+			for (j = 0; err == MMC_ERR_NONE &&
+			    j < nitems(fields); j++) {
+				if (ext_csd[fields[j]] !=
+				    ivar->raw_ext_csd[fields[j]])
+					err = MMC_ERR_FAILED;
+			}
+			if (err == MMC_ERR_NONE)
+				width = widths[i].width;
+			/* Back to 1 bit, whether this width works or not. */
+			(void)mmc_switch(sc->dev, sc->dev, ivar->rca,
+			    EXT_CSD_CMD_SET_NORMAL, EXT_CSD_BUS_WIDTH,
+			    EXT_CSD_BUS_WIDTH_1, ivar->cmd6_time, true);
+			mmcbr_set_bus_width(sc->dev, bus_width_1);
+			mmcbr_update_ios(sc->dev);
+		}
+		sc->squelched--;
+	}
+	free(ext_csd, M_DEVBUF);
+	return (width);
+}
