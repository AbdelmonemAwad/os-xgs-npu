#!/bin/sh
#-
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 Abdelmonem Awad <eg2@live.com>
#
# Release the Marvell NPU from reset. Numbered 06, and the number is load-bearing in both
# directions.
#
# It must run before OPNsense configures its interfaces, because on these boards there are none at
# all until it has. And it must run AFTER OPNsense's own 05-upgrade, which is, in full:
#
#     for STAGE in K B P; do
#         if opnsense-update -${STAGE}; then echo "Rebooting now."; reboot; fi
#     done
#
# That hook finalises a pending firmware update and reboots from inside the early sequence. Run
# ahead of it - which these hooks did, as 01 and 02 - and the coprocessor is live and bus-mastering
# into host memory when that reboot fires, writing received frames into physical addresses the next
# kernel is about to hand to something else. docs/npuep/porting-notes.md records that symptom class under
# a different trigger: a fault in an unrelated subsystem, minutes later, with nothing logged in
# between. Running after 05-upgrade costs nothing on an ordinary boot and removes the interaction.
#
# On a Sophos XGS the NPU owns every front port, and it comes out of power-on HELD: the MCP2210
# USB-to-SPI bridge loads its factory NVRAM pin state, which for the 126/136 is GP3=1, GP5=0,
# and that keeps the NPU in reset. The vendor's software releases it somewhere in its own startup. Nothing in
# OPNsense does, which is why this appliance booted with a completely silent NPU and no ports.
#
# It has to be a PULSE - hold, then release - and not simply a write of the release state.
# That was measured, not assumed: on a cold boot this hook wrote the release values, the tool's
# readback agreed (command 0x32 then - a write of the pins' direction, not a read; mcp2210.py reads
# with 0x31 since 2026-11-05), and the NPU stayed dead with ZERO receive interrupts on its console.
# Driving the pins high and then low starts it every time. What the part wants is an edge, not
# a level.
#
# And it is written to the bridge's VOLATILE settings only, so it does not survive a power
# cycle - which is why this runs on every boot rather than being a one-off.
#
# Deliberately quiet and deliberately harmless on the wrong hardware: if the bridge is not
# there, or the board is not one whose pin values we know, it logs and exits 0. This runs on
# every boot of every machine the plugin is installed on, so it must never be the reason a
# firewall fails to come up.

: ${NPUCTL:=/usr/local/opnsense/scripts/npuctl/mcp2210.py}
: ${BOARDSH:=/usr/local/opnsense/scripts/xgs/board.sh}

log() { /usr/bin/logger -t npuctl -p daemon.notice "$1"; }

# ONLY ON AN ARMADA BOARD, decided from the board's own assembly number before anything is loaded or
# opened. Every guard below this one decides by elimination, and the one that matters most - "is there
# a /dev/hidraw0" - is satisfied by the XGS 3300's MCP2210 too, which on that board is wired to the
# coprocessor's reset and boot flash. This script once ran there: the pulse took the 3300's coprocessor
# off the bus, and OPNsense dropped the WAN's assignment from config.xml on the boot that followed.
#
# Only the ARMADA boards whose reset values have run at boot, any variant: board 201 (the XGS 136 here;
# the XGS 126 is the same board) and board 208 (an XGS 116 r1, by its owner, #1037, #1040). Since
# 2026-10-21 board.sh marks a model not run here "rnd", and this guard went on matching " armada" alone,
# so from v0.1.0-alpha.5 every ARMADA board but the XGS 136 booted without the pulse (#1047) - the XGS
# 116 r1 with no ports, though its driver loaded by hand found all nine; with the pulse they come up at
# every boot. Boards 200 (XGS 87, 107; the vendor's table drives its lines the other way round) and 224
# (XGS 138) stay out: their values have run at no boot, and owners of an XGS 107 and a 107w have their
# front ports without any pulse (#748, #890). A wrong value there would take every front port away at
# the first boot after an update, so they wait for an owner's run (#1047).
board=$(/bin/sh "${BOARDSH}" 2>/dev/null)
case "${board}" in
"201 armada"|"201 armada rnd"|"208 armada"|"208 armada rnd")
	;;
"200 armada"*|"224 armada"*)
	log "board '${board}': its reset values have run at no boot yet; the coprocessor is left as power-on left it (#1047)"
	exit 0
	;;
*)
	log "board '${board:-unreadable}' is not an ARMADA board; its MCP2210 is left alone"
	exit 0
	;;
esac

# NEVER ON AN OCTEON TX APPLIANCE, and checked before anything is loaded or opened.
#
# The guard below - "is there a /dev/hidraw0" - was written on the assumption that a machine without
# the XGS 136's bridge would have no such node. The XGS 3300 has an MCP2210 as well, and on that board
# it is the bridge the vendor's xgs-usb-spi-flash uses to write the coprocessor's boot flash. So that
# guard passes there, and this script would send the 136's reset sequence to the 3300's boot flash
# bridge at every boot. install.sh no longer puts this file on an OCTEON TX machine; this is for the
# copy an older version of it already did.
if /usr/sbin/pciconf -l 2>/dev/null |
    grep -qE 'chip=0xa300177d|vendor=0x177d[[:space:]]+device=0xa300'; then
    log "OCTEON TX appliance - its MCP2210 reaches the coprocessor's boot flash, not an NPU reset line; nothing to do"
    exit 0
fi

# hidraw(4) is what gives us /dev/hidraw0 for the bridge. hidbus attaches on its own but leaves
# no device node until a child driver claims it.
if ! /sbin/kldstat -q -m hidraw; then
    /sbin/kldload hidraw 2>/dev/null
fi

if [ ! -c /dev/hidraw0 ]; then
    log "no /dev/hidraw0 - no MCP2210 bridge on this machine, nothing to do"
    exit 0
fi

if [ ! -f "${NPUCTL}" ]; then
    log "missing ${NPUCTL}"
    exit 0
fi

out=$(/usr/local/bin/python3 "${NPUCTL}" pulse 2>&1)
rc=$?
if [ ${rc} -eq 0 ]; then
    log "NPU reset pulsed: ${out}"
else
    # Not fatal. A firewall that boots without its NPU is still a firewall you can log into and
    # fix; one that refuses to boot is not.
    log "NPU reset pulse FAILED (rc=${rc}): ${out}"
fi

exit 0
