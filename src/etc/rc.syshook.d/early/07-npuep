#
# Load the NPU endpoint driver, and wait for its interfaces before OPNsense configures them.
#
# Numbered 07 so it runs after 06-npuctl, and the order is not a preference: 06 is what pulses the
# coprocessor out of reset, and until that has happened there is no live device here to attach to.
# Both are numbered above OPNsense's own 05-upgrade, for a reason 06-npuctl sets out at length.
# The same fact rules out loader.conf, along with a second one - the BAR restore this hardware
# needs only happens on the kldload path. See docs/npuep/porting-notes.md.
#
# THE WAITING MATTERS MORE THAN THE LOADING. Every early hook runs before OPNsense configures its
# interfaces, so if the front ports exist by the time this returns, the firewall's own
# configuration finds them and they can carry rules. If it returns too soon they are simply absent
# from that pass, and no amount of correct driver code afterwards puts them back into it.
#
# The coprocessor needs roughly half a minute from its reset pulse before it answers at all, and
# its network agent a further ten seconds after that. So this waits, and reports how long it took -
# a number worth watching, because it is the one that decides whether this hook is worth its delay.
#
# It gives up rather than hanging. A firewall that boots late is better than one that boots without
# its ports, and a firewall that does not boot at all is worse than both. Every failure here logs
# and exits 0: no module, unfamiliar hardware, a coprocessor that never answers.
#
# One property of the hardware rather than of this script: the datapath attaches once per
# COPROCESSOR boot, so a host reboot on its own is not enough - the coprocessor is still running
# from before and will not answer a second bring-up. What restores it is the reset pulse 06-npuctl
# issues on every boot, which is a real reset and therefore a second coprocessor boot. That is
# verified, and a cold power cycle is NOT required; this file said it was, for weeks, on no
# evidence. If the ports are missing anyway, contrib/npuep/reload.sh pulses and then waits for the
# endpoint the way this hook does not.

: ${MODULE:=/boot/modules/npuep.ko}
: ${FIRST_IF:=npup1}
: ${WAIT:=45}
# The two loader commands as variables, so the decision below can be tested with the real script
# and the real files without unloading a running driver: KLDSTAT=/usr/bin/false CHECK=1 runs it
# as if nothing were loaded and stops after saying which module it would load. As in
# scripts/octep/bringup.sh.
: ${KLDSTAT:=/sbin/kldstat}
: ${KLDLOAD:=/sbin/kldload}

log() { /usr/bin/logger -t npuep -p daemon.notice "$1"; }

# WHAT A BOOT DOES ONCE THE FRONT PORTS ARE THERE: the management link, the acceleration gate,
# what the owner keeps with the host, the flow maker and the coprocessor's counts - each as the
# settings page left it. A function, because a reload of the module needs exactly this too:
# contrib/npuep/reload.sh resets the coprocessor, which forgets the gate, and loads a driver that
# starts with no exclusion and the flow maker off, and it runs "07-npuep settings" once the ports
# are back (measured 2026-10-20: after a reload without it the flow maker stayed off, whatever the
# settings page said, and an IPsec soak started on it would have measured another machine).
after_ports() {
    #
    # The management link over PCIe establishes only when this end is up: the driver
    # publishes its rings on `up` and the coprocessor answers LINK_ESTABLISHED (issue
    # 374). Nothing else brings mvmgmt0 up, OPNsense least of all when the interface
    # has no assignment yet, so it is done here, before the interfaces are configured.
    # A failure is logged and ignored: the ports do not depend on it.
    #
    if /sbin/ifconfig mvmgmt0 up 2>/dev/null; then
        log "mvmgmt0 up - the management link to the coprocessor is establishing"
    else
        log "mvmgmt0 could not be brought up; the console remains the path to the coprocessor"
    fi
    #
    # The acceleration gate, as the settings page left it. This coprocessor forgets the
    # word at every boot, and scripts/xgs/offload.sh is the one thing that writes it - on
    # this family by hand on the rpc channel, which opens a few seconds after the ports, so
    # it is waited for briefly. Never fatal: the ports do not depend on it, and the script's
    # own report says what happened.
    #
    j=0
    while [ ${j} -lt 20 ]; do
        case "$(/sbin/sysctl -n dev.npuep.0.rpc_channel.state 2>/dev/null | head -1)" in
        open*) break ;;
        esac
        j=$((j + 1))
        sleep 1
    done
    if [ -x /usr/local/opnsense/scripts/xgs/offload.sh ]; then
        log "offload gate after ${j}s: $(/usr/local/opnsense/scripts/xgs/offload.sh 2>/dev/null | tr -d '\n')"
    fi
    #
    # The ports' own addresses (issue 730): the driver asks the network agent for each port's
    # address of the appliance's range once the agent answers, some seconds after the rpc
    # channel, and the ports take them. OPNsense configures the interfaces after this hook - a
    # DHCP lease, an IPv6 link-local address and a bridge all take the address a port has then -
    # so this waits for them, briefly. -1 is "not asked yet"; never fatal.
    #
    k=0
    while [ ${k} -lt 30 ]; do
        M=$(/sbin/sysctl -n dev.npuep.0.nwa.macs_from_agent 2>/dev/null)
        [ -n "${M}" ] && [ "${M}" -ge 0 ] 2>/dev/null && break
        k=$((k + 1))
        sleep 1
    done
    MSG="the ports' own addresses after ${k}s: ${M:-not asked} of $(/sbin/ifconfig -l | /usr/bin/tr ' ' '\n' | /usr/bin/grep -c '^npup') taken from the network agent"
    log "${MSG}"
    echo "npuep: ${MSG}"
    # What the owner keeps with the host (XGS: Settings, "Never offloaded"), before the flow
    # maker can make anything: the driver starts with no exclusion whatever the page says.
    if [ -f /usr/local/opnsense/scripts/xgs/flow_exclude.php ]; then
        log "never offloaded: $(/usr/local/bin/php /usr/local/opnsense/scripts/xgs/flow_exclude.php 2>/dev/null)"
    fi
    # The flow maker, from the same settings page: off unless turned on there.
    AUTO=$(/usr/local/bin/php -r 'require_once("config.inc"); echo empty($config["OPNsense"]["XGS"]["general"]["flow_auto"]) ? "0" : "1";' 2>/dev/null)
    case ${AUTO} in
    0|1) /sbin/sysctl -q dev.npuep.0.flow.auto=${AUTO} > /dev/null 2>&1 && log "automatic acceleration ${AUTO}" ;;
    esac
    # Cut in hardware, from the same page: plain connections made with the microflow action IPS,
    # so that a cut can drop one on the coprocessor by its verdict - offload.sh has set the fast
    # path's IPS switch with the gate. On unless the owner turned it off there (discovery 3).
    CUT=$(/usr/local/bin/php -r 'require_once("config.inc"); $g = $config["OPNsense"]["XGS"]["general"] ?? []; echo (isset($g["cut_in_hardware"]) && $g["cut_in_hardware"] === "0") ? "1" : "2";' 2>/dev/null)
    case ${CUT} in
    1|2) /sbin/sysctl -q dev.npuep.0.flow.mflow_action=${CUT} > /dev/null 2>&1 && log "microflow action ${CUT}" ;;
    esac
    # Inspect, then hardware, from the same page (discovery 4): oxips0 is here when the marker had
    # the driver make the inspector's function this load. /var/run/os-xgs-npu.oxips0 tells the
    # Intrusion Detection's template overlay, written after this hook (15-templates), that Suricata
    # may be given oxips0 - it does not start when an interface it is given is missing.
    /bin/rm -f /var/run/os-xgs-npu.oxips0
    if /sbin/ifconfig oxips0 > /dev/null 2>&1; then
        /usr/bin/touch /var/run/os-xgs-npu.oxips0
        INSPECT=$(/usr/local/bin/php -r 'require_once("config.inc"); echo empty($config["OPNsense"]["XGS"]["general"]["inspect_then_hardware"]) ? "0" : "1";' 2>/dev/null)
        if [ "${INSPECT}" = "1" ]; then
            /sbin/ifconfig oxips0 up
            /sbin/sysctl -q dev.npuep.0.flow.ips_new=1 > /dev/null 2>&1 && log "inspect, then hardware: oxips0 up, new connections inspected"
        fi
    fi
    # And the coprocessor's own counts of what it forwards, to pf's states and rules and to the
    # interfaces' counters: on unless the owner turned them off on the same page.
    for KV in count_to_pf:hw_to_pf count_ports:lif_apply; do
        V=$(/usr/local/bin/php -r 'require_once("config.inc"); $g = $config["OPNsense"]["XGS"]["general"] ?? []; echo (isset($g["'${KV%%:*}'"]) && $g["'${KV%%:*}'"] === "0") ? "0" : "1";' 2>/dev/null)
        case ${V} in
        0|1) /sbin/sysctl -q dev.npuep.0.flow.${KV#*:}=${V} > /dev/null 2>&1 && log "${KV%%:*} ${V}" ;;
        esac
    done
}

if [ "${1:-}" = settings ]; then
    if ! /sbin/ifconfig "${FIRST_IF}" >/dev/null 2>&1; then
        log "settings: ${FIRST_IF} is not there, nothing applied"
        exit 0
    fi
    after_ports
    exit 0
fi

if [ ! -f "${MODULE}" ]; then
    # Not an error. The module is built on the appliance rather than packaged - it is C against
    # this kernel's headers - so a machine that has the plugin but not the module is a normal
    # state, not a broken one.
    log "no ${MODULE} - the driver is not installed on this machine, nothing to do"
    exit 0
fi

# REFUSE A MODULE BUILT AGAINST A DIFFERENT KERNEL, as scripts/octep/bringup.sh does and for the
# reason set out there at length: a FreeBSD module's kernel dependency is a range, so kldload
# accepts one built against another 15.x kernel and it then reads every structure whose layout
# moved at the wrong offset. contrib/npuep/build.sh and install/kernel-follow.sh stamp the module
# with the kernel it was built against; this is what reads the stamp at boot. Until 2026-10-13
# nothing did on this appliance, and a kernel update would have loaded the old module unchecked.
#
# The refusal costs the front ports and, through OPNsense dropping the assignments of absent
# devices, their entries in config.xml. So it is not meant to be reached: the follower rebuilds the
# module before the reboot that changes the kernel, keeps the one it replaced as .prev stamped for
# the kernel it was built for, and that one is loaded here when the running kernel is the old one
# again. FORCE=1 loads a mismatched module anyway - a thing to do deliberately, never from a hook.
BUILT=$(cat "${MODULE}.kernel" 2>/dev/null || true)
NOW=$(/usr/bin/uname -v)
if [ -z "${BUILT}" ]; then
    log "no kernel stamp beside ${MODULE} - nothing can tell whether it matches this kernel"
elif [ "${BUILT}" != "${NOW}" ]; then
    log "${MODULE} was built against a different kernel"
    log "  built  : ${BUILT}"
    log "  running: ${NOW}"
    if ${KLDSTAT} -q -n npuep; then
        log "a working npuep is already loaded, so carrying on - but rebuild it with install/kernel-follow.sh before the next boot"
    elif [ "$(cat ${MODULE}.prev.kernel 2>/dev/null)" = "${NOW}" ] && [ -f "${MODULE}.prev" ]; then
        log "but ${MODULE}.prev matches this kernel exactly - loading that instead"
        MODULE=${MODULE}.prev
    elif [ "${FORCE:-0}" = "1" ]; then
        log "FORCE=1, loading it anyway"
    else
        log "refusing to load it; run install/kernel-follow.sh while a kernel this module matches is still running, or set FORCE=1 if you know the layouts did not change"
        exit 0
    fi
fi

if [ "${CHECK:-0}" = "1" ]; then
    log "CHECK=1: would load ${MODULE}"
    echo "CHECK=1: would load ${MODULE}"
    exit 0
fi

#
# IPsec's crypto sessions to software providers only (issue 399). This host's AMD ccp(4) - loaded by
# device match, or by a loader line for its random-number source - is a hardware provider, the kernel
# prefers hardware for IPsec, and ccp failed every AES-GCM operation it was given: a tunnel the
# coprocessor did not take ran with every packet dropped as "no transform". With the selection at
# software, aesni(4) takes the sessions - measured 2026-10-17 with ccp loaded: no drop, 901 Mbit/s
# through a tunnel - and ccp stays for what it does well. Done before the driver, so on every boot
# of this appliance and before any tunnel exists. IPsec is a module here, ipsec.ko, which OPNsense
# loads later in the boot when it starts the service, so the knob does not exist yet at this point:
# the module is loaded first (kldload -n: nothing if it is there), which is all OPNsense would do.
# A row for net.inet.ipsec.crypto_support in System > Settings > Tunables is applied after this and
# wins.
#
CRYPTO_SOFTWARE=33554432	# CRYPTOCAP_F_SOFTWARE, 0x02000000
# The settings page can turn it off (ipsec_soft_crypto); it is on unless it says 0.
SOFT=$(/usr/local/bin/php -r 'require_once("config.inc"); $g = $config["OPNsense"]["XGS"]["general"] ?? []; echo (isset($g["ipsec_soft_crypto"]) && $g["ipsec_soft_crypto"] === "0") ? "0" : "1";' 2>/dev/null)
${KLDLOAD} -n ipsec >/dev/null 2>&1 || true
if [ "${SOFT}" = "0" ]; then
    log "IPsec's crypto sessions left to the kernel's choice - turned off on the settings page"
elif [ "$(/sbin/sysctl -n net.inet.ipsec.crypto_support 2>/dev/null)" != "${CRYPTO_SOFTWARE}" ]; then
    if /sbin/sysctl net.inet.ipsec.crypto_support=${CRYPTO_SOFTWARE} >/dev/null 2>&1; then
        log "IPsec's crypto sessions held to software providers (aesni), so ccp takes none - issue 399"
    else
        log "could not hold IPsec's crypto sessions to software (no net.inet.ipsec) - issue 399"
    fi
fi

if ${KLDSTAT} -q -n npuep; then
    log "already loaded, nothing to do"
    exit 0
fi

# The driver's settings as the configuration has them, for this load: a configuration restored
# since the last boot is in /boot/loader.conf only from the boot after (issue 669).
SET=$(/bin/sh /usr/local/opnsense/scripts/xgs/tunables-kenv.sh hw.npuep. 2>/dev/null | /usr/bin/tr '\n' ' ')
if [ -n "${SET}" ]; then
    # On the console as well: this runs before syslog does, and a logger line here is lost.
    echo "npuep: taken from the configuration for this load, not yet in the loader's: ${SET% }"
    log "taken from the configuration for this load, not yet in the loader's: ${SET% }"
fi

# The inspector's functions, an experiment (discovery 4): published only while the marker is there.
if [ -e /var/db/os-xgs-npu/inspector-vf ]; then
    /bin/kenv hw.npuep.ips_vf=1 > /dev/null 2>&1
    echo "npuep: the inspector's functions published this load"
fi

if ! ${KLDLOAD} "${MODULE}" 2>/dev/null; then
    log "kldload ${MODULE} failed - the front ports will not be available this boot"
    exit 0
fi

i=0
while [ ${i} -lt "${WAIT}" ]; do
    if /sbin/ifconfig "${FIRST_IF}" >/dev/null 2>&1; then
        log "front ports present after ${i}s - OPNsense can configure them"
        after_ports
        exit 0
    fi
    i=$((i + 1))
    sleep 1
done

log "waited ${WAIT}s and ${FIRST_IF} never appeared; carrying on so the firewall still boots - see the npuep messages in dmesg for why"
exit 0
