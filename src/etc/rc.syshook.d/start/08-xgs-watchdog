#
# The host's hardware watchdog, armed at the end of every boot when the setting says so -
# scripts/xgs/watchdog.sh. Never fails the boot.
SCRIPT=/usr/local/opnsense/scripts/xgs/watchdog.sh
[ -f "${SCRIPT}" ] || exit 0
/bin/sh "${SCRIPT}" start > /dev/null 2>&1
exit 0
