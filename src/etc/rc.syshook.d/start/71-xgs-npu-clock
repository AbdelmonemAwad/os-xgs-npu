#
# The coprocessor's clock set from this host's at the end of the boot (scripts/xgs/npu-clock.sh).
# The coprocessor may still be coming up, so it is tried every 15 s for up to five minutes, in the
# background so the boot does not wait; cron keeps it right after that, every ten minutes.
C=/usr/local/opnsense/scripts/xgs/npu-clock.sh
[ -f "${C}" ] || exit 0
(
	i=0
	while [ ${i} -lt 20 ]; do
		/bin/sh "${C}" && exit 0
		i=$((i + 1))
		sleep 15
	done
) > /dev/null 2>&1 &
exit 0
