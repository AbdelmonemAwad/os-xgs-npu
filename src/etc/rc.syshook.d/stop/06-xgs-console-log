#
# The coprocessor's console logger stopped at an orderly shutdown -
# scripts/xgs/console_log.py.
SCRIPT=/usr/local/opnsense/scripts/xgs/console_log.py
[ -f "${SCRIPT}" ] || exit 0
/usr/local/bin/python3 "${SCRIPT}" stop > /dev/null 2>&1
exit 0
