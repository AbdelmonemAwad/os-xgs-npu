#
# Rebuild the module against the kernel an update has just installed, before the host reboots onto it.
#
# THE LEVEL IS `upgrade`, AND THAT WAS CHECKED RATHER THAN ASSUMED. The first version of this file sat
# in rc.syshook.d/update, which looks like the obvious home: the directory exists and OPNsense ships a
# script in it. Nothing on this appliance passes `update` to rc.syshook. The callers pass facility,
# stop, start, monitor, upgrade, import, early and carp - so that file would have been read by nobody,
# which is the most expensive kind of wrong, because it looks like a guarantee and it is a file.
#
# `upgrade` is called, from scripts/firmware/upgrade.sh, and here is where it sits:
#
#	opnsense-update -u                 the packages
#	rc.syshook upgrade                 <-- this file
#	opnsense-update -K -c ; -K         the pending kernel is applied to /boot
#	reboot
#
# Which means the new kernel is NOT in /boot when we run - it is a set waiting in the pending
# directory - and after it is applied the reboot follows with no hook in between. So the follower reads
# the staged set first and /boot second; see install/kernel-follow.sh.
#
# Numbered 20 so it runs after OPNsense's own hooks at that level. Nothing here depends on them; the
# number keeps the order stable.
#
# IT NEVER FAILS AN UPDATE. An update that stops half way is worse than a module that needs rebuilding
# by hand, so every path here exits 0. What a failure costs is a loud warning in the log and, at the
# reboot that follows, a boot on kernel.old wherever the module is built for the kernel in /boot now -
# one kernel behind, with its front ports: stop/20-octep arms that fall-back first, then tries the
# rebuild again. Only a module built for neither kernel leaves a boot where the front ports do not
# come up. Until 2026-11-06 the warning below said every failure did.
#
# NOR DOES IT HOLD ONE, and until 2026-11-06 it could. The follower waits up to fifteen minutes for
# another run's lock and then fetches hundreds of megabytes of kernel sources, with no time limit
# given to the fetch, and this ran it with none either: on a slow or stalled line the update sat on
# this hook for as long as the line took. LIMIT bounds it now, as the stop hook bounds its own run;
# about a minute fetched and built the module on the XGS 136 in October
# (docs/measurements/image-136-2026-10-21.md). A run that is cut off leaves the module unbuilt, which
# is where a failure leaves it anyway, and the reboot that follows takes it from there.
#
# Nothing happens at all on a machine with no coprocessor, no module, or no kernel change, which is
# every machine most of the time.

: ${FOLLOW:=/usr/local/opnsense/scripts/octep/kernel-follow.sh}
: ${LIMIT:=600}

log() { /usr/bin/logger -t octep -p daemon.notice "$1"; }
warn() { /usr/bin/logger -t octep -p daemon.err "$1"; }

# Only on hardware a driver of this project claims: the OCTEON TX coprocessor (177d:a300, octep) or
# the ARMADA one (11ab:7080, npuep) - the follower finds out which module is installed. Both
# spellings of each identity, because pciconf prints one or the other depending on the release and
# matching only the packed form once made the boot hook skip on the very machine it was written
# for. Until 2026-10-13 this gate knew only the OCTEON TX, so on the ARMADA appliance an update
# never ran the follower at all.
if ! /usr/sbin/pciconf -l 2>/dev/null |
    grep -qE 'chip=0xa300177d|vendor=0x177d[[:space:]]+device=0xa300|chip=0x708011ab|vendor=0x11ab[[:space:]]+device=0x7080'; then
	exit 0
fi

if [ ! -x "${FOLLOW}" ]; then
	warn "no ${FOLLOW} - cannot check whether the module still matches the kernel"
	exit 0
fi

if OUT=$(/usr/bin/timeout -k 10 "${LIMIT}" /bin/sh "${FOLLOW}" 2>&1); then
	# The follower is quiet and exits 0 when there is nothing to do, which is the normal case, so
	# only say something when it actually rebuilt.
	case "${OUT}" in
	*"installed /boot/modules/"*)
		log "the kernel moved and the module followed it; the next boot needs nothing done by hand"
		;;
	esac
else
	rc=$?
	if [ ${rc} -eq 124 ] || [ ${rc} -eq 137 ]; then
		warn "the module was not rebuilt within ${LIMIT}s for the kernel this update installs; the update goes on"
	else
		warn "the module could NOT be rebuilt for the kernel this update installs"
	fi
	# What the next boot then does is the stop hook's, at the reboot that follows (see the top).
	warn "the reboot that follows tries again; where that fails too and the module is built for the kernel in /boot now - kernel.old once this update has applied its own - that boot takes kernel.old, one kernel behind, with its front ports"
	warn "where it is built for neither, that boot refuses it and the front ports - including the WAN - will not come up"
	warn "run: sh /usr/local/opnsense/scripts/octep/kernel-follow.sh   while this kernel is still running"
	# Nothing, from a run cut off while it waited for another run's lock - and not an empty line then.
	[ -z "${OUT}" ] || echo "${OUT}" | /usr/bin/tail -12 | while read -r l; do warn "  ${l}"; done
fi

exit 0
