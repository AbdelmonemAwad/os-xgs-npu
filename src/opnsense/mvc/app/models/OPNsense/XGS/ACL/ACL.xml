<acl>
    <!--
        The tags keep the ids they had when the pages were under Interfaces, System: Settings and
        System: Firmware, so a privilege already granted to a user or group keeps working now that
        the pages are in one section of the menu. Only the names shown were changed.
    -->
    <page-interfaces-diagnostics-xgs>
        <name>XGS: Overview, Ports, Transceivers, IPsec, Offloaded Flows and Coprocessor Ping</name>
        <description>Allow reading the XGS coprocessor's status, ports, transceivers, IPsec engine and offloaded flows; these pages change nothing</description>
        <patterns>
            <pattern>ui/xgs/status</pattern>
            <!-- the About page: the project, its author, its addresses and the disclaimer -->
            <pattern>ui/xgs/about</pattern>
            <pattern>api/xgs/status/*</pattern>
            <pattern>ui/xgs/ports</pattern>
            <pattern>api/xgs/ports/*</pattern>
            <pattern>ui/xgs/transceivers</pattern>
            <pattern>api/xgs/transceivers/*</pattern>
            <pattern>ui/xgs/ipsec</pattern>
            <pattern>api/xgs/ipsec/*</pattern>
            <pattern>ui/xgs/flows</pattern>
            <pattern>api/xgs/flows/*</pattern>
            <!-- a ping sent by the coprocessor over the management link: a few packets, nothing changed -->
            <pattern>ui/xgs/ping</pattern>
            <pattern>api/xgs/ping/*</pattern>
        </patterns>
    </page-interfaces-diagnostics-xgs>
    <!--
        Read only (plan 01, package 3.9, 2026-11-15): OPNsense's privileges are address patterns, so each of
        these grants a page and the requests it reads with - search, get, list - and none it saves, adds,
        deletes or applies with, which answer such a user "forbidden". A request's name decides: "get*"
        reaches get_item and not set_item. Only pages whose reading and saving go to different addresses
        can be offered so; the older ones, which read and save at one, are not listed.
        tools/test-readonly-acl.py checks each against the requests its page makes on OPNsense 26.7.
    -->
    <page-xgs-ro-firewall-alias>
        <name>Read only: Firewall: Aliases</name>
        <description>Allow seeing the firewall's aliases and their contents, without changing them (from os-xgs-npu)</description>
        <patterns>
            <pattern>ui/firewall/alias</pattern>
            <pattern>api/firewall/alias/search*</pattern>
            <pattern>api/firewall/alias/get*</pattern>
            <pattern>api/firewall/alias/list*</pattern>
            <pattern>api/firewall/alias/export*</pattern>
        </patterns>
    </page-xgs-ro-firewall-alias>
    <page-xgs-ro-firewall-filter>
        <name>Read only: Firewall: Rules [new]</name>
        <description>Allow seeing the firewall's rules and their counters, without changing or applying them (from os-xgs-npu)</description>
        <patterns>
            <pattern>ui/firewall/filter</pattern>
            <pattern>api/firewall/filter/search*</pattern>
            <pattern>api/firewall/filter/get*</pattern>
            <pattern>api/firewall/filter/list*</pattern>
            <pattern>api/firewall/filter/download_rules*</pattern>
            <pattern>api/firewall/filter_util/rule_stats*</pattern>
        </patterns>
    </page-xgs-ro-firewall-filter>
    <page-xgs-ro-trust-cert>
        <name>Read only: System: Trust: Certificates</name>
        <description>Allow seeing the certificates and their details, without changing them or downloading a private key (from os-xgs-npu)</description>
        <patterns>
            <pattern>ui/trust/cert</pattern>
            <pattern>api/trust/cert/search*</pattern>
            <pattern>api/trust/cert/get*</pattern>
            <pattern>api/trust/cert/ca_info*</pattern>
            <pattern>api/trust/cert/ca_list*</pattern>
            <pattern>api/trust/cert/user_list*</pattern>
            <pattern>api/trust/cert/raw_dump*</pattern>
        </patterns>
    </page-xgs-ro-trust-cert>
    <page-xgs-ro-ipsec-connections>
        <name>Read only: VPN: IPsec: Connections</name>
        <description>Allow seeing the IPsec connections and pools, without changing them or applying the service (from os-xgs-npu)</description>
        <patterns>
            <pattern>ui/ipsec/connections</pattern>
            <pattern>api/ipsec/connections/search*</pattern>
            <pattern>api/ipsec/connections/get*</pattern>
            <pattern>api/ipsec/connections/is_enabled*</pattern>
            <pattern>api/ipsec/connections/connection_exists*</pattern>
            <pattern>api/ipsec/pools/search*</pattern>
            <pattern>api/ipsec/pools/get*</pattern>
        </patterns>
    </page-xgs-ro-ipsec-connections>
    <page-xgs-ro-xgs-settings>
        <name>Read only: XGS: Settings</name>
        <description>Allow seeing the XGS coprocessor's settings and status, without changing or applying them</description>
        <patterns>
            <pattern>ui/xgs/settings</pattern>
            <pattern>api/xgs/settings/get*</pattern>
            <pattern>api/xgs/settings/recommended</pattern>
            <pattern>api/xgs/status/*</pattern>
            <pattern>api/xgs/ipsec/*</pattern>
        </patterns>
    </page-xgs-ro-xgs-settings>
    <page-system-trust-xgs-certimport>
        <name>XGS: Certificate Import</name>
        <!--
            Reads a certificate file into PEM and nothing else: what it reads is stored by System:
            Trust's own API, which the user needs the Trust privileges for as well.
        -->
        <description>Allow reading a certificate file in DER, PKCS#7 or PKCS#12 into PEM, for System: Trust to import</description>
        <patterns>
            <pattern>ui/xgs/certimport</pattern>
            <pattern>api/xgs/certimport/*</pattern>
        </patterns>
    </page-system-trust-xgs-certimport>
    <page-system-settings-xgs>
        <name>XGS: Settings</name>
        <!--
            A separate tag from the status page, and not a convenience. This one grants the power
            to take traffic out of the firewall's path: with offloading on, a frame the coprocessor
            recognises is forwarded by the coprocessor and pf never sees it. That is a firewall
            decision, so it is granted to whoever is trusted with firewall decisions - and not
            bundled in with reading a table of counters.
        -->
        <description>Allow changing the XGS coprocessor settings, among them whether it forwards traffic without passing it to the firewall</description>
        <patterns>
            <pattern>ui/xgs/settings</pattern>
            <pattern>api/xgs/settings/*</pattern>
            <pattern>api/xgs/offload/*</pattern>
            <!-- a PoE port's power switched off or on, from the Ports page -->
            <pattern>api/xgs/poe/*</pattern>
            <!--
                The status reader as well, because the settings page needs one thing out of it: the
                gate's live value. There is no log to fall back on - bringup.sh runs before syslogd
                and its messages at boot go nowhere - so after a reboot the only way to see whether
                the gate is actually open is to read it, and a page with a switch on it that cannot
                show the switch's effect is worse than no page.
            -->
            <pattern>api/xgs/status/*</pattern>
            <!-- and the IPsec reader, for the Status row that says what the driver was started with -->
            <pattern>api/xgs/ipsec/*</pattern>
        </patterns>
    </page-system-settings-xgs>
    <page-system-firmware-xgs>
        <name>XGS: Updates</name>
        <!--
            Its own tag, because it grants installing software from the internet and rebooting
            the firewall - firmware rights, not the right to read counters or set the gate.
        -->
        <description>Allow updating the XGS coprocessor driver from its repository, and rebooting to load it</description>
        <patterns>
            <pattern>ui/xgs/updates</pattern>
            <pattern>api/xgs/updates/*</pattern>
        </patterns>
    </page-system-firmware-xgs>
    <page-xgs-reports>
        <name>XGS: Problem Reports</name>
        <!--
            Its own tag: it decides what this appliance sends to the project and sends it, which is
            neither reading counters nor setting the coprocessor's gate. Its controller reads and
            writes the reporting section of the model and nothing else.
        -->
        <description>Allow choosing how problem reports are sent, reading them and sending them</description>
        <patterns>
            <pattern>ui/xgs/reports</pattern>
            <pattern>api/xgs/reports/*</pattern>
        </patterns>
    </page-xgs-reports>
</acl>
