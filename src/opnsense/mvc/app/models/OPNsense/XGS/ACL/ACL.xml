<acl>
    <!--
        The tags keep the ids they had when the pages were under Interfaces, System: Settings and
        System: Firmware, so a privilege already granted to a user or group keeps working now that
        the pages are in one section of the menu. Only the names shown were changed.
    -->
    <page-interfaces-diagnostics-xgs>
        <name>XGS Coprocessor: Overview, Ports and IPsec</name>
        <description>Allow reading the XGS coprocessor's status, ports and IPsec engine; these pages change nothing</description>
        <patterns>
            <pattern>ui/xgs/status</pattern>
            <pattern>api/xgs/status/*</pattern>
            <pattern>ui/xgs/ports</pattern>
            <pattern>api/xgs/ports/*</pattern>
            <pattern>ui/xgs/ipsec</pattern>
            <pattern>api/xgs/ipsec/*</pattern>
        </patterns>
    </page-interfaces-diagnostics-xgs>
    <page-system-settings-xgs>
        <name>XGS Coprocessor: Settings</name>
        <!--
            A separate tag from the status page, and not a convenience. This one grants the power
            to take traffic out of the firewall's path: with offloading on, a frame the coprocessor
            recognises is forwarded by the coprocessor and pf never sees it. That is a firewall
            decision, so it is granted to whoever is trusted with firewall decisions - and not
            bundled in with reading a table of counters.
        -->
        <description>Allow changing the XGS coprocessor settings, among them whether it forwards traffic without passing it to the firewall</description>
        <patterns>
            <pattern>ui/xgs/settings</pattern>
            <pattern>api/xgs/settings/*</pattern>
            <pattern>api/xgs/offload/*</pattern>
            <!--
                The status reader as well, because the settings page needs one thing out of it: the
                gate's live value. There is no log to fall back on - bringup.sh runs before syslogd
                and its messages at boot go nowhere - so after a reboot the only way to see whether
                the gate is actually open is to read it, and a page with a switch on it that cannot
                show the switch's effect is worse than no page.
            -->
            <pattern>api/xgs/status/*</pattern>
            <!-- and the IPsec reader, for the Status row that says what the driver was started with -->
            <pattern>api/xgs/ipsec/*</pattern>
        </patterns>
    </page-system-settings-xgs>
    <page-system-firmware-xgs>
        <name>XGS Coprocessor: Updates</name>
        <!--
            Its own tag, because it grants installing software from the internet and rebooting
            the firewall - firmware rights, not the right to read counters or set the gate.
        -->
        <description>Allow updating the XGS coprocessor driver from its repository, and rebooting to load it</description>
        <patterns>
            <pattern>ui/xgs/updates</pattern>
            <pattern>api/xgs/updates/*</pattern>
        </patterns>
    </page-system-firmware-xgs>
</acl>
