<menu>
    <!--
        One section of the main menu for everything the coprocessor has, between Interfaces (30)
        and Firewall (40): its overview, its settings, its ports, its IPsec engine, its updates and
        its log. They used to be in three places - the settings under System: Settings, the status
        under Interfaces: Diagnostics, the updates under System: Firmware - and an owner looking
        for one of them had to know which errand OPNsense filed it under. Here they are where the
        hardware is.

        The order is OPNsense's own: what the section is for first, upkeep after, the logs last -
        as VPN: IPsec and Services: Unbound DNS have it. The appliance's own pages (10-45), then
        the family's plugins by subject (50-58: hardware, the system, protection, reports), then
        Updates and Problem Reports (80, 85), then the three logs (90-92: the plugin's own, the
        coprocessor's console, the coprocessor's own log since 2026-10-28), and About at the end.

        The family's plugins put their pages in this section when this package is installed, under
        the same name and attributes, and in the section their subject belongs to when it is not.
        OPNsense's menu takes no condition, so each writes its own menu file: its
        scripts/<plugin>/place-menu.sh, run by its install and by this package's install and
        removal (since 2026-10-25; until then they were in their own sections only, whatever this
        comment said).

        The settings page still cannot go into System: Settings: Miscellaneous: that page is core,
        its two hardware lists are hardcoded and it calls no plugin hook - docs/octep/offload-is-a-setting.md.

        Named XGS since 2026-10-18: "XGS Coprocessor" broke over two lines in the collapsed menu,
        under its icon and over the next one. XGS is the product line's own name, the same in
        every language.
    -->
    <XGS VisibleName="XGS" cssClass="fa fa-microchip fa-fw" order="35">
        <Overview order="10" VisibleName="Overview" cssClass="fa fa-gauge-high fa-fw" url="/ui/xgs/status"/>
        <Settings order="20" VisibleName="Settings" cssClass="fa fa-sliders fa-fw" url="/ui/xgs/settings"/>
        <Ports order="30" VisibleName="Ports" cssClass="fa fa-ethernet fa-fw" url="/ui/xgs/ports"/>
        <Transceivers order="35" VisibleName="Transceivers" cssClass="fa fa-right-left fa-fw" url="/ui/xgs/transceivers"/>
        <IPsec order="40" VisibleName="IPsec" cssClass="fa fa-lock fa-fw" url="/ui/xgs/ipsec"/>
        <Flows order="45" VisibleName="Offloaded Flows" cssClass="fa fa-bolt fa-fw" url="/ui/xgs/flows"/>
        <Updates order="80" VisibleName="Updates" cssClass="fa fa-cloud-arrow-down fa-fw" url="/ui/xgs/updates"/>
        <Reports order="85" VisibleName="Problem Reports" cssClass="fa fa-bug fa-fw" url="/ui/xgs/reports"/>
        <LogFile order="90" VisibleName="Log File" cssClass="fa fa-file-lines fa-fw" url="/ui/diagnostics/log/core/xgs"/>
        <ConsoleLog order="91" VisibleName="Coprocessor Console" cssClass="fa fa-terminal fa-fw" url="/ui/diagnostics/log/xgs/npu-console"/>
        <CoprocessorLog order="92" VisibleName="Coprocessor Log" cssClass="fa fa-rectangle-list fa-fw" url="/ui/diagnostics/log/xgs/coprocessor"/>
        <About order="99" VisibleName="About" cssClass="fa fa-circle-info fa-fw" url="/ui/xgs/about"/>
    </XGS>
</menu>
