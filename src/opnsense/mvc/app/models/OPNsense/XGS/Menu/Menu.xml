<menu>
    <!--
        One section of the main menu for everything the coprocessor has, between Interfaces (30)
        and Firewall (40): its overview, its settings, its ports, its IPsec engine, its updates and
        its log. They used to be in three places - the settings under System: Settings, the status
        under Interfaces: Diagnostics, the updates under System: Firmware - and an owner looking
        for one of them had to know which errand OPNsense filed it under. Here they are where the
        hardware is.

        The family's plugins (Link Health, Fan Control, Front Panel, Network Report and the ones
        after them) put their pages in this section when this package is installed, from 62 on,
        under the same name and attributes, and in the section their subject belongs to when it is
        not. OPNsense's menu takes no condition, so each writes its own menu file: its
        scripts/<plugin>/place-menu.sh, run by its install and by this package's install and
        removal (since 2026-10-25; until then they were in their own sections only, whatever this
        comment said).

        The settings page still cannot go into System: Settings: Miscellaneous: that page is core,
        its two hardware lists are hardcoded and it calls no plugin hook - docs/octep/offload-is-a-setting.md.

        Named XGS since 2026-10-18: "XGS Coprocessor" broke over two lines in the collapsed menu,
        under its icon and over the next one. XGS is the product line's own name, the same in
        every language.
    -->
    <XGS VisibleName="XGS" cssClass="fa fa-microchip fa-fw" order="35">
        <Overview order="10" VisibleName="Overview" url="/ui/xgs/status"/>
        <Settings order="20" VisibleName="Settings" url="/ui/xgs/settings"/>
        <Ports order="30" VisibleName="Ports" url="/ui/xgs/ports"/>
        <Transceivers order="35" VisibleName="Transceivers" url="/ui/xgs/transceivers"/>
        <IPsec order="40" VisibleName="IPsec" url="/ui/xgs/ipsec"/>
        <Flows order="45" VisibleName="Offloaded Flows" url="/ui/xgs/flows"/>
        <Updates order="50" VisibleName="Updates" url="/ui/xgs/updates"/>
        <Reports order="60" VisibleName="Problem Reports" url="/ui/xgs/reports"/>
        <LogFile order="90" VisibleName="Log File" url="/ui/diagnostics/log/core/xgs"/>
        <ConsoleLog order="91" VisibleName="Coprocessor Console" url="/ui/diagnostics/log/xgs/npu-console"/>
        <About order="99" VisibleName="About" url="/ui/xgs/about"/>
    </XGS>
</menu>
