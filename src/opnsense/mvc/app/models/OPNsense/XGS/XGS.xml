<model>
    <mount>//OPNsense/XGS</mount>
    <version>1.1.0</version>
    <description>XGS coprocessor</description>
    <items>
        <!--
            The settings an owner decides, and only those.
            Everything else the coprocessor can be told is reachable only through the rpc sysctls,
            which are instruments: they stage a request, they have no idea what the firewall is
            doing, and a wrong value in one of them is a dropped LAN rather than a rejected form.
            They do not belong behind a save button. What is here is either a gate the owner is
            entitled to open (offload, flow_auto, ipsec_offload, ipsec_flows), a boot behaviour
            (switch_jumbo, ipsec_soft_crypto) or a measured tuning of the receive path (rx_poll_ms,
            rx_budget). scripts/xgs/apply.php writes them where each one takes effect - the
            coprocessor, a running sysctl, or a loader tunable through OPNsense's own Tunables -
            and bringup.sh, 07-npuep and switch-jumbo.sh read them back at boot by exactly these
            paths, so the names here are not free. A field one family does not have is ignored there.
        -->
        <general>
            <offload type="BooleanField">
                <Required>Y</Required>
                <!--
                    Off.

                    Three reasons, in the order they were learned. The coprocessor comes up with
                    fw_cfg 0x2 - TCP_SEQ_CHK alone, no offload - so off is also what the hardware
                    itself defaults to, and a plugin that silently differed from the hardware
                    would be the first thing to suspect and the last thing anybody looked at.

                    Then: with the gate open, a frame that the fast path decides it can handle
                    does not reach pf. That is the entire point of it, and it is also the reason
                    it is not a default. Nothing in this package may quietly take traffic out of
                    the firewall's path on the strength of having been installed.

                    And: opening the gate by itself accelerates nothing. A frame leaves the
                    host's path only once the driver has put its connection in hardware, and the
                    flow maker that does that - dp.auto on the OCTEON TX, flow.auto on the ARMADA -
                    is off unless set; see docs/findings/the-state-is-the-gate.md and
                    docs/npuep/offload-plan.md. So the honest default is the one that changes
                    nothing until there is something to change.
                -->
                <Default>0</Default>
            </offload>
            <!-- The flow maker: dp.auto on the OCTEON TX, flow.auto on the ARMADA. Off, for the
                 offload gate's reasons: it is what takes a connection out of the firewall's path. -->
            <flow_auto type="BooleanField">
                <Required>Y</Required>
                <Default>0</Default>
            </flow_auto>
            <!-- What the owner keeps with the host: addresses, networks and ports never offloaded,
                 written to dp.flow_exclude or flow.exclude by scripts/xgs/flow_exclude.php when the
                 page is saved and at every boot. Only the characters are checked here; the script
                 reads each entry and names one it cannot read. -->
            <flow_exclude type="TextField">
                <Required>N</Required>
                <Mask>/^[0-9A-Za-z:.\/,;\s]{0,1500}$/</Mask>
                <ValidationMessage>Addresses, networks and "port N" entries, separated by commas or new lines.</ValidationMessage>
            </flow_exclude>
            <!-- IPsec associations to the coprocessor's engine: the loader tunable hw.octep.ipsec_on
                 or hw.npuep.ipsec_on, read when the driver attaches - a reboot takes it. -->
            <ipsec_offload type="BooleanField">
                <Required>Y</Required>
                <Default>0</Default>
            </ipsec_offload>
            <!-- OCTEON TX only: an association's flows forwarded by the coprocessor itself
                 (hw.octep.ipsec_flows=1). The value 2 exists in the driver and is never offered:
                 it forwards matching clear text that arrives on the tunnel's port. -->
            <ipsec_flows type="BooleanField">
                <Required>Y</Required>
                <Default>0</Default>
            </ipsec_flows>
            <!-- ARMADA only: keep IPsec's software sessions off the host's AMD ccp(4) (issue 399). -->
            <ipsec_soft_crypto type="BooleanField">
                <Required>Y</Required>
                <Default>1</Default>
            </ipsec_soft_crypto>
            <!-- ARMADA only: the receive poll, measured in docs/findings/a-hundred-polls-a-second-on-the-armada.md. -->
            <rx_poll_ms type="IntegerField">
                <Required>Y</Required>
                <Default>1</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>100</MaximumValue>
            </rx_poll_ms>
            <rx_budget type="IntegerField">
                <Required>Y</Required>
                <Default>1024</Default>
                <MinimumValue>4</MinimumValue>
                <MaximumValue>4096</MaximumValue>
            </rx_budget>
            <!--
                The flow table's size and the transmit queues, both read by the driver when it
                attaches (docs/families/board-limits.md). 0 is the driver's own choice - the board's
                figure capped by a 16th of memory, and as many queues as CPUs - and removes the
                tunable rather than writing 0, which the driver would take as its minimum.
            -->
            <flow_max type="IntegerField">
                <Required>Y</Required>
                <Default>0</Default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>2000000</MaximumValue>
            </flow_max>
            <tx_queues type="IntegerField">
                <Required>Y</Required>
                <Default>0</Default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>7</MaximumValue>
            </tx_queues>
            <!-- Jumbo frames through the switch chip at every boot (scripts/xgs/switch-jumbo.sh). -->
            <switch_jumbo type="BooleanField">
                <Required>Y</Required>
                <Default>1</Default>
            </switch_jumbo>
            <!--
                The host's hardware watchdog (scripts/xgs/watchdog.sh): watchdogd at every boot, so a
                host that stops scheduling is reset by the timer instead of waiting for somebody to
                pull the power. On by the owner's decision, 2026-10-17.
            -->
            <watchdog type="BooleanField">
                <Required>Y</Required>
                <Default>1</Default>
            </watchdog>
        </general>
        <!--
            Problem reports (scripts/xgs/reporter.py, docs/problem-reports.md): what goes wrong on
            this appliance, cleaned of addresses and serials, filed as a GitHub issue through the
            project's relay. Automatic by default, by the project's decision, and said so in a banner
            on every page until the owner has looked at the Problem Reports page; manual keeps each
            report until its Send is pressed; off looks at nothing.
        -->
        <reporting>
            <mode type="OptionField">
                <Required>Y</Required>
                <Default>automatic</Default>
                <OptionValues>
                    <automatic>Automatic: send each report as it is found</automatic>
                    <manual>Manual: keep each report until I send it</manual>
                    <off>Off: look for nothing and send nothing</off>
                </OptionValues>
            </mode>
            <!-- Kept by the relay with the issue's number, never in the issue itself. -->
            <email type="EmailField">
                <Required>N</Required>
            </email>
        </reporting>
    </items>
</model>
